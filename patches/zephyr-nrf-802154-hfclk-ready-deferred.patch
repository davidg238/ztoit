diff --git a/modules/hal_nordic/nrf_802154/sl_opensource/platform/nrf_802154_clock_zephyr.c b/modules/hal_nordic/nrf_802154/sl_opensource/platform/nrf_802154_clock_zephyr.c
index 024d856a7cc..893dde74998 100644
--- a/modules/hal_nordic/nrf_802154/sl_opensource/platform/nrf_802154_clock_zephyr.c
+++ b/modules/hal_nordic/nrf_802154/sl_opensource/platform/nrf_802154_clock_zephyr.c
@@ -38,11 +38,45 @@ bool nrf_802154_clock_hfclk_is_running(void)
 
 static struct onoff_client hfclk_cli;
 
+/*
+ * nrf_802154_clock_hfclk_start() is asynchronous by contract: the driver calls
+ * it from inside its critical section, while changing state, and must not get
+ * nrf_802154_clock_hfclk_ready() before it has left that section. When the
+ * clock is already on for another user (USB, for one), onoff_request() notifies
+ * from inside the call. That notification is deferred to the system timer
+ * interrupt, which delivers it once it can take the critical section itself.
+ */
+bool nrf_802154_critical_section_enter(void);
+void nrf_802154_critical_section_exit(void);
+
+#define HFCLK_READY_DELAY K_TICKS(2)
+
+static bool hfclk_requesting;
+
+static void hfclk_ready_deferred(struct k_timer *timer)
+{
+	if (!nrf_802154_critical_section_enter()) {
+		k_timer_start(timer, HFCLK_READY_DELAY, K_NO_WAIT);
+		return;
+	}
+
+	hfclk_is_running = true;
+	nrf_802154_clock_hfclk_ready();
+	nrf_802154_critical_section_exit();
+}
+
+static K_TIMER_DEFINE(hfclk_ready_timer, hfclk_ready_deferred, NULL);
+
 static void hfclk_on_callback(struct onoff_manager *mgr,
 			      struct onoff_client  *cli,
 			      uint32_t state,
 			      int res)
 {
+	if (hfclk_requesting) {
+		k_timer_start(&hfclk_ready_timer, HFCLK_READY_DELAY, K_NO_WAIT);
+		return;
+	}
+
 	hfclk_is_running = true;
 	nrf_802154_clock_hfclk_ready();
 }
@@ -65,7 +99,9 @@ void nrf_802154_clock_hfclk_start(void)
 		nrf_sys_event_request_global_constlat();
 	}
 
+	hfclk_requesting = true;
 	int ret = onoff_request(mgr, &hfclk_cli);
+	hfclk_requesting = false;
 
 	__ASSERT_NO_MSG(ret >= 0);
 	(void)ret;
@@ -77,6 +113,8 @@ void nrf_802154_clock_hfclk_stop(void)
 
 	__ASSERT_NO_MSG(mgr != NULL);
 
+	k_timer_stop(&hfclk_ready_timer);
+
 	int ret = onoff_cancel_or_release(mgr, &hfclk_cli);
 
 	__ASSERT_NO_MSG(ret >= 0);
@@ -113,7 +151,9 @@ void nrf_802154_clock_hfclk_start(void)
 	}
 #endif
 
+	hfclk_requesting = true;
 	int ret = nrf_clock_control_request(CLK_DEV, NULL, &hfclk_cli);
+	hfclk_requesting = false;
 
 	__ASSERT_NO_MSG(ret >= 0);
 	(void)ret;
@@ -121,6 +161,8 @@ void nrf_802154_clock_hfclk_start(void)
 
 void nrf_802154_clock_hfclk_stop(void)
 {
+	k_timer_stop(&hfclk_ready_timer);
+
 	int ret = nrf_clock_control_cancel_or_release(CLK_DEV, NULL, &hfclk_cli);
 
 	__ASSERT_NO_MSG(ret >= 0);
