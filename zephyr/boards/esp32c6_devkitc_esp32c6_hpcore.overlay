/* The WROOM-1-N8 has 8 MB of flash; the board's default table uses the lower
 * 4 MB. The upper 4 MB is Toit's flash registry (flash_registry_zephyr.cc). */
&flash0 {
	partitions {
		toit_partition: partition@400000 {
			label = "toit";
			reg = <0x400000 DT_SIZE_M(4)>;
		};
	};
};

/* The C6's 802.15.4 radio (disabled in esp32c6_common.dtsi). Its driver builds
 * only with CONFIG_IEEE802154 (prj_thread.conf). */
&ieee802154 {
	status = "okay";
};
