/* The WROOM-1-N8 has 8 MB of flash; the board's default table uses the lower
 * 4 MB. The upper 4 MB is Toit's flash registry (flash_registry_zephyr.cc). */
/delete-node/ &slot0_lpcore_partition;
/delete-node/ &slot1_lpcore_partition;

&flash0 {
	partitions {
		toit_partition: partition@400000 {
			label = "toit";
			reg = <0x400000 DT_SIZE_M(4)>;
		};

		/* The agent's staging area (zephyr/src/agent/store.c): where Zephyr's
		 * ESP32 tables had scratch_partition until 4.5 dropped it (#47). */
		stage_partition: partition@3e0000 {
			compatible = "zephyr,mapped-partition";
			label = "stage";
			reg = <0x3e0000 DT_SIZE_K(124)>;
		};
		/* The remote console's ring (zephyr/src/agent/store.c, FCB): where the
		 * default table has the two lpcore slots, which ztoit does not use. */
		log_partition: partition@3a0000 {
			compatible = "zephyr,mapped-partition";
			label = "log";
			reg = <0x3a0000 DT_SIZE_K(64)>;
		};
	};
};

/* The C6's 802.15.4 radio (disabled in esp32c6_common.dtsi). Its driver builds
 * only with CONFIG_IEEE802154 (prj_thread.conf). */
&ieee802154 {
	status = "okay";
};

/* #7 I/O, wired 2026-11-14: the DI is the board's BOOT button (GPIO9,
 * `user_button1` in the board dts; a strapping pin, so held at reset it enters
 * download mode). An output on GPIO3, and an Adafruit BMP180 breakout on the
 * board's i2c0 (SDA GPIO6, SCL GPIO7; breakout pull-ups, VIN from 3V3). Toit
 * names these by devicetree label.
 * The on-board RGB LED (WS2812 on GPIO8, the upstream led_strip sample's
 * ws2812-i2s) needs no wiring either, so BOOT + RGB test ztoit on a bare board.
 * Only the data line is routed: the WS2812 needs no I2S clock pins. */
#include <zephyr/dt-bindings/led/led.h>

/ {
	/* Toit's standard gpio library (#62): pin n is GPIO n. Zephyr's gpio0 has
	 * GPIO0..29 (esp32c6_common.dtsi, ngpios = 30), so GPIO30 is no pin.
	 * Reserved, needing --allow-restricted:
	 *   3       the DO (gpio-leds `do0`, below)
	 *   4, 5    strapping pins MTMS, MTDI (datasheet, "Strapping Pins")
	 *   6, 7    i2c0 SDA, SCL (board pinctrl i2c0_default), the BMP180's bus
	 *   8       strapping pin; the WS2812's data line (i2s_led_default, below)
	 *   9       strapping pin (boot mode); BOOT button (gpio-keys `user_button1`)
	 *   12, 13  USB Serial/JTAG D-, D+ (USB_INT_PHY0_DM/DP_GPIO_NUM)
	 *   15      strapping pin (JTAG source)
	 *   16, 17  UART0 TX, RX: the console (board pinctrl uart0_default)
	 *   24..29  the module's SPI flash (IO_MUX SPICS0, SPIQ, SPIWP, VDD_SPI,
	 *           SPIHD, SPICLK; SPID on GPIO30)
	 * Free: 0, 1, 2, 10, 11, 14, 18..23 (spi2 is disabled below, and this
	 * overlay's i2s pinctrl routes only GPIO8). */
	toit-platform {
		compatible = "toit,platform";
		gpio-ports = <&gpio0>;
		reserved-pins = <3 4 5 6 7 8 9 12 13 15 16 17 24 25 26 27 28 29>;
	};

	leds {
		compatible = "gpio-leds";
		do0: do_0 {
			label = "DO";
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		};
	};
};

&i2c0 {
	bmp180: bmp180@77 {
		compatible = "bosch,bmp180";
		reg = <0x77>;
		osr-press = <1>;
	};
};

/* The board dts enables spi2 with SCLK on GPIO6 and MOSI on GPIO7, i2c0's pins.
 * ztoit uses no SPI; off so it cannot take the BMP180's bus. */
&spi2 {
	status = "disabled";
};

&pinctrl {
	i2s_led_default: i2s_led_default {
		group1 {
			pinmux = <I2S_O_SD_GPIO8>;
		};
	};
};

&i2s {
	status = "okay";
	pinctrl-0 = <&i2s_led_default>;
	pinctrl-names = "default";
	dmas = <&dma 3>;
	dma-names = "tx";

	rgb_led: ws2812@0 {
		compatible = "worldsemi,ws2812-i2s";
		reg = <0>;
		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		reset-delay = <500>;
	};
};

&dma {
	status = "okay";
};
