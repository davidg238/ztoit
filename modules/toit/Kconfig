config TOIT
	bool "Toit VM core"
	depends on CPP
	help
	  Compile the Toit VM core from $TOIT_SRC (see ztoit's env.sh).

config TOIT_HEAP_SIZE
	int "Bytes in the static arena Toit heap pages come from"
	default 163840
	depends on TOIT

config TOIT_HEAP_NOINIT
	bool "Put the arena in .noinit"
	depends on TOIT
	help
	  On the ESP32 with ESP32_REGION_1_NOINIT this moves the arena to the
	  second DRAM bank, leaving the first to the C heap.

config TOIT_THREAD_DOWN_DETACH
	bool "Thread down = disabled"
	depends on NET_L2_OPENTHREAD
	help
	  Down = Thread disabled (each net.open rejoins); default: stay attached
	  as a sleepy end device (ztoit design §7).

config TOIT_AGENT
	bool "The C agent: check in with porta over CoAP (rete #521)"
	depends on NETWORKING && NET_IPV4
	select COAP_CLIENT
	select ZCBOR
	select ZCBOR_CANONICAL
	select MBEDTLS
	select MBEDTLS_SHA256
	select REBOOT
	help
	  On each new IPv4 address (each net.open on WiFi) pull the node's
	  batch from porta and push obs/build; install goal/apps images
	  (nodus-toit design §5, addendum 2026-11-17).

config TOIT_AGENT_PORTA
	string "porta's CoAP address (IPv4 literal)"
	depends on TOIT_AGENT
	help
	  Deployment-specific: set it in the git-ignored prj_wifi.local.conf.

config TOIT_AGENT_PORT
	int "porta's CoAP port"
	default 5683
	depends on TOIT_AGENT

config TOIT_AGENT_PUBKEY
	string "porta's ed25519 public key (64 hex digits, porta's pub key file)"
	default ""
	depends on TOIT_AGENT
	help
	  Images are installed only if signed by this key. Deployment-specific:
	  set it in the git-ignored local conf. Empty: nothing installs, and the
	  agent says so on the console.

config TOIT_AGENT_STACK_SIZE
	int "Agent thread stack"
	default 5120
	depends on TOIT_AGENT
	help
	  The ed25519 check is the deepest path: about 4.1 KB on the ESP32
	  (gcc -fstack-usage, 2026-11-17: ed25519_verify 2352 + add 1200 +
	  M 304 + the agent's frames), where a check-in needed 3072.
